    </rule>
    <rule match-type="regex">
        <name>Javascript</name>
        <from>^/advertise/js_core/single_([0-9]+).link</from>
        <to>/advertise/view/advjs.jsp?id=$1</to>
    </rule>
    <rule match-type="regex">
